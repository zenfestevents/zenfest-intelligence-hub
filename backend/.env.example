# Copy this file to ".env" (same folder) and fill in the values below.
# Never commit .env: it is listed in .gitignore.

# Supabase (a NEW free project for Zenfest, not the AI Hub's):
# Project Settings -> Database -> Connection string -> "Session pooler".
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Apify token from the Zenfest Apify account (Console -> Settings -> API & Integrations).
# Used only by instagram_ingest.py.
APIFY_TOKEN=
# Instagram stops spending when the Apify account has used this much this month (free credit = $5).
APIFY_MONTHLY_CAP_USD=4.50

# Self-hosted RSSHub, no trailing slash (see rsshub/README.md). The AI Hub's server can be shared.
RSSHUB_URL=https://zenfest-rsshub.onrender.com
